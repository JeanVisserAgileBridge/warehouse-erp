<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="warehouseCode" class="form-label">Code</label>
        <InputText id="warehouseCode" class="form-control" @bind-Value="Model.Code" />
        <ValidationMessage For="() => Model.Code" />
    </div>

    <div class="mb-3">
        <label for="warehouseName" class="form-label">Name</label>
        <InputText id="warehouseName" class="form-control" @bind-Value="Model.Name" />
        <ValidationMessage For="() => Model.Name" />
    </div>

    <div class="mb-3">
        <label for="warehouseAddress" class="form-label">Address</label>
        <InputTextArea id="warehouseAddress" class="form-control" @bind-Value="Model.Address" />
        <ValidationMessage For="() => Model.Address" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">@SubmitLabel</button>
        <a class="btn btn-secondary" href="warehouses">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public WarehouseFormModel Model { get; set; } = null!;

    [Parameter]
    public string SubmitLabel { get; set; } = "Save";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();
}
