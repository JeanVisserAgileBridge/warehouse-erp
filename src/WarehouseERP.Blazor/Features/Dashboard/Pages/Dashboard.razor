@page "/"
@inject IDashboardApiClient DashboardApiClient

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<ErrorAlert Message="@_errorMessage" />

@if (_isLoading)
{
    <LoadingIndicator Text="Loading dashboard..." />
}
else if (_summary is not null)
{
    <div class="row g-3">
        <div class="col-sm-6 col-lg-4">
            <StatCard Label="Total Categories" Value="@_summary.TotalCategories.ToString()" />
        </div>
        <div class="col-sm-6 col-lg-4">
            <StatCard Label="Active Categories" Value="@_summary.ActiveCategories.ToString()" />
        </div>
        <div class="col-sm-6 col-lg-4">
            <StatCard Label="Total Products" Value="@_summary.TotalProducts.ToString()" />
        </div>
        <div class="col-sm-6 col-lg-4">
            <StatCard Label="Active Products" Value="@_summary.ActiveProducts.ToString()" />
        </div>
        <div class="col-sm-6 col-lg-4">
            <StatCard Label="Inactive Products" Value="@_summary.InactiveProducts.ToString()" />
        </div>
    </div>
}

@code {
    private DashboardSummary? _summary;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await DashboardApiClient.GetSummaryAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
