<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="purchaseOrderSupplier" class="form-label">Supplier</label>
        <InputSelect id="purchaseOrderSupplier" class="form-select" @bind-Value="Model.SupplierId">
            <option value="">Select a supplier</option>
            @foreach (var supplier in Suppliers)
            {
                <option value="@supplier.Id">@supplier.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.SupplierId" />
    </div>

    <div class="mb-3">
        <label for="purchaseOrderNumber" class="form-label">Order Number</label>
        <InputText id="purchaseOrderNumber" class="form-control" @bind-Value="Model.OrderNumber" />
        <ValidationMessage For="() => Model.OrderNumber" />
    </div>

    <div class="mb-3">
        <label for="purchaseOrderDate" class="form-label">Order Date</label>
        <InputDate id="purchaseOrderDate" class="form-control" @bind-Value="Model.OrderDate" />
        <ValidationMessage For="() => Model.OrderDate" />
    </div>

    <div class="mb-3">
        <label for="purchaseOrderNotes" class="form-label">Notes</label>
        <InputTextArea id="purchaseOrderNotes" class="form-control" @bind-Value="Model.Notes" />
        <ValidationMessage For="() => Model.Notes" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">Create</button>
        <a class="btn btn-secondary" href="purchase-orders">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PurchaseOrderFormModel Model { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<SupplierDto> Suppliers { get; set; } = [];

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();
}
