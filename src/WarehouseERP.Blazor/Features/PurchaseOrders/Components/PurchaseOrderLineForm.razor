<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    <div class="row g-2 align-items-start">
        <div class="col-auto" style="min-width: 220px;">
            @if (ProductLocked)
            {
                <div class="form-control-plaintext">@LockedProductName</div>
            }
            else
            {
                <InputSelect class="form-select" @bind-Value="Model.ProductId">
                    <option value="">Select a product</option>
                    @foreach (var product in Products)
                    {
                        <option value="@product.Id">@product.Sku - @product.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.ProductId" />
            }
        </div>
        <div class="col-auto">
            <InputNumber class="form-control" @bind-Value="Model.QuantityOrdered" placeholder="Quantity" />
            <ValidationMessage For="() => Model.QuantityOrdered" />
        </div>
        <div class="col-auto">
            <InputNumber class="form-control" @bind-Value="Model.UnitPrice" placeholder="Unit Price" />
            <ValidationMessage For="() => Model.UnitPrice" />
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">@SubmitLabel</button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" class="btn btn-secondary" @onclick="HandleCancelAsync">Cancel</button>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PurchaseOrderLineFormModel Model { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<ProductDto> Products { get; set; } = [];

    [Parameter]
    public bool ProductLocked { get; set; }

    [Parameter]
    public string? LockedProductName { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Add Line";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();

    private Task HandleCancelAsync() => OnCancel.InvokeAsync();
}
