<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="salesOrderCustomer" class="form-label">Customer</label>
        <InputSelect id="salesOrderCustomer" class="form-select" @bind-Value="Model.CustomerId">
            <option value="">Select a customer</option>
            @foreach (var customer in Customers)
            {
                <option value="@customer.Id">@customer.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.CustomerId" />
    </div>

    <div class="mb-3">
        <label for="salesOrderNumber" class="form-label">Order Number</label>
        <InputText id="salesOrderNumber" class="form-control" @bind-Value="Model.OrderNumber" />
        <ValidationMessage For="() => Model.OrderNumber" />
    </div>

    <div class="mb-3">
        <label for="salesOrderDate" class="form-label">Order Date</label>
        <InputDate id="salesOrderDate" class="form-control" @bind-Value="Model.OrderDate" />
        <ValidationMessage For="() => Model.OrderDate" />
    </div>

    <div class="mb-3">
        <label for="salesOrderNotes" class="form-label">Notes</label>
        <InputTextArea id="salesOrderNotes" class="form-control" @bind-Value="Model.Notes" />
        <ValidationMessage For="() => Model.Notes" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">Create</button>
        <a class="btn btn-secondary" href="sales-orders">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public SalesOrderFormModel Model { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<CustomerDto> Customers { get; set; } = [];

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();
}
