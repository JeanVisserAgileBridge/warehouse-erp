<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="supplierName" class="form-label">Name</label>
        <InputText id="supplierName" class="form-control" @bind-Value="Model.Name" />
        <ValidationMessage For="() => Model.Name" />
    </div>

    <div class="mb-3">
        <label for="supplierEmail" class="form-label">Email</label>
        <InputText id="supplierEmail" class="form-control" @bind-Value="Model.Email" />
        <ValidationMessage For="() => Model.Email" />
    </div>

    <div class="mb-3">
        <label for="supplierPhoneNumber" class="form-label">Phone Number</label>
        <InputText id="supplierPhoneNumber" class="form-control" @bind-Value="Model.PhoneNumber" />
        <ValidationMessage For="() => Model.PhoneNumber" />
    </div>

    <div class="mb-3">
        <label for="supplierAddress" class="form-label">Address</label>
        <InputTextArea id="supplierAddress" class="form-control" @bind-Value="Model.Address" />
        <ValidationMessage For="() => Model.Address" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">@SubmitLabel</button>
        <a class="btn btn-secondary" href="suppliers">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public SupplierFormModel Model { get; set; } = null!;

    [Parameter]
    public string SubmitLabel { get; set; } = "Save";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    private Task HandleValidSubmitAsync() => OnValidSubmit.InvokeAsync();
}
