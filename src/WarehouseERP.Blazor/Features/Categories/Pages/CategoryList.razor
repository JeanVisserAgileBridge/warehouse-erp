@page "/categories"
@inject ICategoryApiClient CategoryApiClient

<PageTitle>Categories</PageTitle>

<h1>Categories</h1>

<a class="btn btn-primary mb-3" href="categories/create">New Category</a>

<ErrorAlert Message="@_errorMessage" />

@if (_isLoading)
{
    <LoadingIndicator Text="Loading categories..." />
}
else if (_categories is not null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in _categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        @if (category.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" href="@($"categories/{category.Id}/edit")">Edit</a>
                        @if (category.IsActive)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => DeactivateAsync(category.Id)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ActivateAsync(category.Id)">Activate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<CategoryDto>? _categories;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadCategoriesAsync();

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _categories = await CategoryApiClient.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ActivateAsync(Guid id)
    {
        _errorMessage = null;

        try
        {
            await CategoryApiClient.ActivateAsync(id);
            await LoadCategoriesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        _errorMessage = null;

        try
        {
            await CategoryApiClient.DeactivateAsync(id);
            await LoadCategoriesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
