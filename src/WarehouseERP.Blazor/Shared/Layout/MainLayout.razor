@inherits LayoutComponentBase
@inject IAuthApiClient AuthApiClient
@inject CookieAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">@context.User.Identity?.Name</span>
                    <button type="button" class="btn btn-link" @onclick="HandleLogoutAsync">Logout</button>
                </Authorized>
            </AuthorizeView>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        AuthenticationStateProvider.NotifyUserLogout();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }
}
