<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WarehouseERP</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <NavSection Title="Product Catalog">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="categories">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Categories
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="products">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Products
                </NavLink>
            </div>
        </NavSection>

        <NavSection Title="Procurement">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="suppliers">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Suppliers
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="purchase-orders">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Purchase Orders
                </NavLink>
            </div>
        </NavSection>

        <NavSection Title="Sales">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customers">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Customers
                </NavLink>
            </div>
        </NavSection>

        <NavSection Title="Warehouse Management">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="warehouses">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Warehouses
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="storage-locations">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Storage Locations
                </NavLink>
            </div>
        </NavSection>

        <NavSection Title="Inventory">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inventory">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Inventory
                </NavLink>
            </div>
        </NavSection>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
